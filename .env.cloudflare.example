# Cloudflare Containers deployment configuration

# Cloudflare account
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Worker URL (set after first deploy, or use custom domain)
# Example: https://serverless-openclaw.your-subdomain.workers.dev
WORKER_URL=https://serverless-openclaw.your-subdomain.workers.dev

# Web UI environment variables (Vite build)
# In Cloudflare architecture, WS and API share the same origin as the Worker
VITE_WS_URL=wss://serverless-openclaw.your-subdomain.workers.dev/api/ws
VITE_API_URL=https://serverless-openclaw.your-subdomain.workers.dev/api/v1

# Cognito (keep existing auth — or migrate to Cloudflare Access later)
VITE_COGNITO_USER_POOL_ID=ap-northeast-2_XXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Secrets (set via `npx wrangler secret put <NAME>`)
# BRIDGE_AUTH_TOKEN — random token for Bridge auth
# OPENCLAW_GATEWAY_TOKEN — OpenClaw gateway auth token
# ANTHROPIC_API_KEY — Anthropic API key for AI
# TELEGRAM_BOT_TOKEN — Telegram bot API token
# TELEGRAM_SECRET_TOKEN — Telegram webhook verification secret
